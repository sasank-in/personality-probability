# Copy to `.env` and fill in. All vars are prefixed PERSONALITY_.

# Embedding provider: "mistral" (production) or "raw" (caller supplies vectors).
PERSONALITY_EMBEDDER=mistral

# Required when PERSONALITY_EMBEDDER=mistral. Get one at https://console.mistral.ai/
PERSONALITY_MISTRAL_API_KEY=

# Optional overrides (defaults shown):
# PERSONALITY_MISTRAL_MODEL=mistral-embed
# PERSONALITY_EMBEDDING_DIM=1024
# PERSONALITY_MAX_TEXT_CHARS=20000
# PERSONALITY_DEVICE=cpu
# PERSONALITY_LOG_LEVEL=INFO
# PERSONALITY_MODEL_PATH=artifacts/personality_model.pt
# PERSONALITY_SCALER_PATH=artifacts/x_scaler.pkl
